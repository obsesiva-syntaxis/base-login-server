            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "POST register - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns user without password', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.not.have.property('password');",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json.email).to.eql('user@demo.com');",
                  "  pm.collectionVariables.set('userId', json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"user@demo.com\", \"password\": \"Demo1234\", \"fullname\": \"Demo User\"}" },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
