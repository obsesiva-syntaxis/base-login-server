{
  "info": {
    "name": "base-login-server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3030/api/v1" },
    { "key": "token", "value": "" },
