# Conexión PostgreSQL (local o manejada, p.ej. Neon).
# En Docker, docker-compose.yaml pasa la misma variable.
DATABASE_URL= ---- COMPLETE THIS -----
SERVER_PORT=3030
JWT_SECRET= ---- COMPLETE THIS (use a long random string) -----
JWT_EXPIRATION=4h
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=*
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
BCRYPT_SALT_ROUNDS=10
TYPEORM_MIGRATIONS_RUN=false
DEFAULT_ROLE=user
DEFAULT_TIMEZONE=America/Santiago
# Si "true" verifica el certificado TLS del servidor PostgreSQL (recomendado en producción).
# Por defecto: false en desarrollo, true si NODE_ENV=production.
DB_SSL_REJECT_UNAUTHORIZED=false